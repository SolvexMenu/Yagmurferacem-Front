model Product {
  id          String           @id @unique @default(cuid())
  name        String
  price       Int
  description String
  imageUrls   String[]
  discount    Int?
  stockCode   String
  available   Boolean
  categories  String[]
  variants    ProductVariant[]
  CartItem    CartItem[]
  Size        Size[]
  Color       Color[]
  OrderItem   OrderItem[]

  @@map("product")
}

model ProductVariant {
  id        String      @id @default(cuid())
  size      Int
  color     String
  available Boolean
  stock     Int         @default(0)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
  OrderItem OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([available])
  @@map("product_variant")
}

model Size {
  id        String  @id @default(cuid())
  size      Int
  available Boolean

  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
  OrderItem OrderItem[]

  @@map("size")
}

model Color {
  id        String  @id @default(cuid())
  color     String
  available Boolean

  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]
  OrderItem OrderItem[]

  @@map("color")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("cart")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Size      Size?           @relation(fields: [sizeId], references: [id])
  sizeId    String?
  Color     Color?          @relation(fields: [colorId], references: [id])
  colorId   String?

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cartItem")
}

model OrderItem {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Size      Size?           @relation(fields: [sizeId], references: [id])
  sizeId    String?
  Color     Color?          @relation(fields: [colorId], references: [id])
  colorId   String?
  Order     Order?          @relation(fields: [orderId], references: [id])
  orderId   String?

  @@unique([orderId, productId, variantId])
  @@index([orderId])
  @@map("orderItem")
}

model Order {
  id              String      @id @default(cuid())
  items           OrderItem[]
  trackingId      String?
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  shippingAddress String?
  billingAddress  String?
  phoneNumber     String?
  notes           String?
  
  // PayTR specific fields
  paymentType     String?     // 'card' or 'eft'
  paidAmount      Float?
  paymentDate     DateTime?
  paymentCurrency String?     // 'TL', 'USD', 'EUR', etc.
  failureReason   String?
  failureCode     String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  User            User?       @relation(fields: [userId], references: [id])
  userId          String?

  @@map("order")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
  FAILED
}

model Banners {
  id          String @id @default(cuid())
  carousel    String[] @default([])
  separator   String @default("")

  @@map("banners")
}
